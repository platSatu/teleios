APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# `php artisan serve` reads SERVER_PORT/SERVER_HOST as its default
# --port/--host when those flags aren't passed explicitly. Fixed at
# 8000 here (fe-konexa's own SERVER_PORT is 8001) so the two apps never
# collide when both are run locally at the same time.
SERVER_PORT=8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teleios
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# fe-konexa frontend — see config/services.php's `frontend` key and
# App\Http\Middleware\VerifyFrontendApiKey, which gates /api/frontend/*
# (category-applications, packages). FRONTEND_API_KEY must be the exact
# same value as TELEIOS_API_KEY in fe-konexa's .env — that's the shared
# secret both sides compare with hash_equals().
FRONTEND_API_URL=http://localhost:8001
FRONTEND_API_KEY=

# Duitku (Payment Gateway Indonesia) — POP flow. Get these from your
# merchant project at https://merchant.duitku.com (sandbox or production).
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_SANDBOX=true
DUITKU_EXPIRY_MINUTES=60
DUITKU_CHECKOUT_TIMEOUT_MINUTES=10

# Google OAuth (Sign in / Sign up with Google) — create an OAuth Client
# at https://console.cloud.google.com (APIs & Services > Credentials).
# GOOGLE_REDIRECT_URI must match, character for character, the
# "Authorized redirect URI" configured there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Cloudflare Turnstile (captcha) — create a widget at
# https://dash.cloudflare.com > Turnstile for your domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
